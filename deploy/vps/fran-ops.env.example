# fran-ops environment — copy to /etc/fran-ops.env on the VPS
#   sudo install -m 640 -o root -g franops deploy/vps/fran-ops.env.example /etc/fran-ops.env
#   sudoedit /etc/fran-ops.env
#
# NEVER commit real secrets. Keep /etc/fran-ops.env mode 640, owned root:franops.

# --- Required (Slack HTTP Events API) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DATABASE_URL=

# HTTP listen port (Caddy reverse-proxies to this)
PORT=3000

# --- Optional ---
# Socket Mode only if you temporarily abandon HTTP Events; leave empty for VPS+Caddy
# SLACK_APP_TOKEN=

# --- Supabase (placeholders for later storage-tiering / cold blobs) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
