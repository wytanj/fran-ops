# fran-ops environment — copy to /etc/fran-ops.env on the VPS
#   sudo install -m 640 -o root -g franops deploy/vps/fran-ops.env.example /etc/fran-ops.env
#   sudoedit /etc/fran-ops.env
#
# NEVER commit real secrets. Keep /etc/fran-ops.env mode 640, owned root:franops.

# --- Required (Slack HTTP Events API) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DATABASE_URL=

# HTTP listen port (Caddy reverse-proxies to this)
PORT=3000

# --- Optional ---
# Socket Mode only if you temporarily abandon HTTP Events; leave empty for VPS+Caddy
# SLACK_APP_TOKEN=

# --- Supabase (placeholders for later storage-tiering / cold blobs) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=

# --- Franbird channel extras + LLM routing (optional) ---
# Comma/semicolon list: C012ABC:ops-floor,C012DEF:shift-lead
# SLACK_EXTRA_CHANNELS=

# LLM gate (xAI Grok). false/absent = keyword-only routing.
# LLM_ROUTING_ENABLED=false
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4-fast-non-reasoning

# --- Telegram (bill-split / franbird scaffold; optional until BotFather) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Comma/semicolon list: 555100:ops-tg,555200:floor
# TELEGRAM_EXTRA_CHATS=

# Hardware issue approver. JT's Slack user id. Required before #it-helpdesk photos open an issue.
# ISSUE_APPROVER_SLACK_USER_ID=

# --- Bill-split notes ---
# Receipt OCR uses LLM_ROUTING_ENABLED + XAI_* when set; otherwise heuristic.
# Ambiguous expense parses always require confirm card /confirm_expense.

# When true, ingest message/app_mention/reaction from any Slack channel the bot is in.
# /bird and findGrant write paths stay on CHANNEL_ALLOWLIST + SLACK_EXTRA_CHANNELS.
# SLACK_LISTEN_ALL=false
